---
import '@fontsource/bona-nova/400.css';
import '@fontsource/bona-nova/400-italic.css';
import '@fontsource-variable/onest/index.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';

interface Props {
  /** Заголовок страницы без названия ресторана */
  title: string;
  description: string;
  /** Полный title без суффикса (для главной) */
  fullTitle?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  hideMobileBooking?: boolean;
  ogImage?: string;
}

const { title, description, fullTitle, noindex = false, jsonLd, hideMobileBooking = false, ogImage = '/og.jpg' } = Astro.props;
const pageTitle = fullTitle ?? `${title} — ресторан «Базилик», Тамбов`;
const site = Astro.site ?? new URL(Astro.url.origin);
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(path, site).href;
const ogImageUrl = new URL(ogImage, site).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f3ede2" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Ресторан «Базилик»" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}

    <!-- Класс .js включает анимации появления. Страховка: если скрипт не загрузился, через 2,5 с показываем всё -->
    <script is:inline>
      (function (d) {
        d.classList.add('js');
        setTimeout(function () { if (!d.dataset.reveal) d.classList.add('reveal-all'); }, 2500);
      })(document.documentElement);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileBar hideBooking={hideMobileBooking} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }
  @media (max-width: 719px) {
    body {
      padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
    }
  }
</style>
