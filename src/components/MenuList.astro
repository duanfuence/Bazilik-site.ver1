---
/**
 * Типографский список позиций: название — отточие — цена, ниже состав и выход.
 * У напитков с несколькими объёмами справа столбик «объём — цена».
 */
import { formatPrice, type MenuItem } from '../data/menu';

interface Props {
  items: MenuItem[];
}
const { items } = Astro.props;
---

<ul class="mlist">
  {
    items.map((item) => (
      <li class="mlist__item">
        <div class="mlist__head">
          <h4 class="mlist__name">
            {item.name}
            {item.isNew && <span class="tag">новинка</span>}
          </h4>
          <span class="mlist__dots" aria-hidden="true" />
          {item.prices?.length ? (
            <dl class="mlist__prices">
              {item.prices.map((p) => (
                <div>
                  <dt>{p.volume}</dt>
                  <dd>{formatPrice(p.price)}</dd>
                </div>
              ))}
            </dl>
          ) : (
            <span class="mlist__price">
              {item.portion && <span class="mlist__portion">{item.portion}</span>}
              {formatPrice(item.price)}
            </span>
          )}
        </div>
        {item.description && <p class="mlist__desc">{item.description}</p>}
      </li>
    ))
  }
</ul>

<style>
  .mlist {
    list-style: none;
    padding: 0;
    display: grid;
    column-gap: clamp(2rem, 1rem + 4vw, 5rem);
  }
  @media (min-width: 900px) {
    .mlist {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .mlist__item {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .mlist__head {
    display: flex;
    flex-wrap: wrap; /* при крупном шрифте цена уходит на следующую строку */
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }
  .mlist__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.2rem, 1.1rem + 0.45vw, 1.5rem);
    line-height: 1.2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    min-width: 0;
  }
  .mlist__dots {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1px dotted var(--line-strong);
    transform: translateY(-0.3em);
  }
  .mlist__price {
    flex: none;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .mlist__portion {
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  /* Несколько объёмов: «150 мл — 490 ₽», «750 мл — 2 450 ₽» */
  .mlist__prices {
    flex: none;
    display: grid;
    gap: 0.15rem;
    font-variant-numeric: tabular-nums;
    font-size: 0.95rem;
  }
  .mlist__prices div {
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.75rem;
  }
  .mlist__prices dt {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .mlist__prices dd {
    margin: 0;
    font-weight: 500;
    white-space: nowrap;
  }
  .mlist__desc {
    margin-top: 0.4rem;
    max-width: 36rem;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
</style>
