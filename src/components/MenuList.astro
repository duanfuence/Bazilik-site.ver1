---
/** Типографский список позиций: название — отточие — цена, ниже описание и выход. */
import { formatPrice, type MenuItem } from '../data/menu';

interface Props {
  items: MenuItem[];
}
const { items } = Astro.props;
---

<ul class="mlist">
  {
    items.map((item) => (
      <li class="mlist__item">
        <div class="mlist__head">
          <h3 class="mlist__name">
            {item.name}
            {item.demo && <span class="demo-tag">демо</span>}
          </h3>
          <span class="mlist__dots" aria-hidden="true" />
          <span class="mlist__price">{formatPrice(item.price)}</span>
        </div>
        {(item.description || item.portion) && (
          <p class="mlist__desc">
            {item.description}
            {item.portion && <span class="mlist__portion"> · {item.portion}</span>}
          </p>
        )}
      </li>
    ))
  }
</ul>

<style>
  .mlist {
    list-style: none;
    padding: 0;
    display: grid;
    column-gap: clamp(2rem, 1rem + 4vw, 5rem);
  }
  @media (min-width: 900px) {
    .mlist {
      grid-template-columns: 1fr 1fr;
    }
  }
  .mlist__item {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .mlist__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .mlist__name {
    font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.6rem);
    line-height: 1.15;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
  }
  .mlist__dots {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1px dotted var(--line-strong);
    transform: translateY(-0.3em);
  }
  .mlist__price {
    flex: none;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .mlist__desc {
    margin-top: 0.4rem;
    max-width: 34rem;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .mlist__portion {
    color: var(--ink-3);
  }
</style>
