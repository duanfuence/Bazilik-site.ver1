---
/** Словесный знак: «Базилик» + лист-знак. Лист нарисован одной линией, как пометка на полях. */
interface Props {
  size?: 'sm' | 'lg';
  class?: string;
}
const { size = 'sm', class: className } = Astro.props;
---

<span class:list={['logo', `logo--${size}`, className]}>
  <svg class="logo__leaf" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M3 21C3 10.5 9.5 3 21 3c0 11.5-7.5 18-18 18Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
    <path d="M3 21 15.5 8.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
  </svg>
  <span class="logo__word">Базилик</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-display);
    line-height: 1;
    white-space: nowrap;
  }
  .logo--sm {
    font-size: 1.65rem;
  }
  .logo--lg {
    font-size: 2.6rem;
  }
  .logo__leaf {
    width: 0.72em;
    height: 0.72em;
    color: var(--tomato);
    transform: translateY(-0.04em);
  }
  :global(.on-dark) .logo__leaf,
  :global(.on-tomato) .logo__leaf {
    color: currentColor;
  }
  .logo__word {
    letter-spacing: -0.01em;
  }
</style>
