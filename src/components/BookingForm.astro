---
/**
 * Заявка на бронирование стола.
 * Важно: отправка — это заявка, а не подтверждённая бронь. Подтверждает администратор по телефону.
 *
 * Схема зала: когда появятся данные о столах (src/data/floor-plan.ts),
 * выбор стола добавляется сюда отдельным шагом и передаётся полем tableId.
 */
import Field from './Field.astro';
import { site } from '../config/site';
import { fromMinutes, toMinutes } from '../lib/hours';

// Полный список времени для режима без JavaScript; со скриптом остаются только доступные слоты
const allTimes: string[] = [];
for (let t = toMinutes('11:00'); t <= toMinutes('23:00'); t += site.booking.slotStepMinutes) allTimes.push(fromMinutes(t));
const max = site.booking.maxGuests;
---

<form class="form booking-form" action="/api/booking" method="post" data-booking-form>
  <Field id="b-date" name="date" label="Дата" as="fieldset">
    <div class="chips date-chips" data-date-chips hidden></div>
    <input class="input date-input" id="b-date" name="date" type="date" required aria-label="Дата визита" />
  </Field>

  <Field id="b-time" name="time" label="Время" as="fieldset">
    <div class="time-groups" data-time-chips hidden></div>
    <p class="notice notice--info" data-no-slots hidden>
      <span>На эту дату онлайн-заявки уже не принимаются. Выберите другой день или позвоните:
        <a href={`tel:${site.phone.tel}`}>{site.phone.local}</a>.</span>
    </p>
    <select class="input" id="b-time" name="time" required data-time-select aria-label="Время визита">
      <option value="">Выберите время</option>
      {allTimes.map((t) => <option value={t}>{t}</option>)}
    </select>
  </Field>

  <Field id="b-guests" name="guests" label="Гостей" hint={`Больше ${max} гостей — оформите заявку на банкет.`}>
    <div class="stepper" data-stepper>
      <button type="button" data-step="-1" aria-label="Меньше гостей" hidden>−</button>
      <input id="b-guests" name="guests" type="number" inputmode="numeric" min="1" max={max} value="2" required aria-describedby="b-guests-hint" />
      <button type="button" data-step="1" aria-label="Больше гостей" hidden>+</button>
    </div>
    <a class="banquet-hint arrow-link" href="/bankety#zayavka" data-banquet-hint hidden>Оформить банкет</a>
  </Field>

  <div class="form__row form__row--2">
    <Field id="b-name" name="name" label="Имя">
      <input class="input" id="b-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="60" />
    </Field>
    <Field id="b-phone" name="phone" label="Телефон" hint="Администратор позвонит, чтобы подтвердить бронь">
      <input class="input" id="b-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required placeholder="+7 900 000-00-00" aria-describedby="b-phone-hint" />
    </Field>
  </div>

  <Field id="b-comment" name="comment" label="Комментарий" hint="Необязательно: повод, детское кресло, пожелания по столу">
    <textarea class="input" id="b-comment" name="comment" maxlength="1000" rows="3" aria-describedby="b-comment-hint"></textarea>
  </Field>

  <div class="hp" aria-hidden="true">
    <label for="b-website">Не заполняйте это поле</label>
    <input id="b-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <Field id="b-consent" name="consent" label="" class="field--consent">
    <label class="check">
      <input id="b-consent" name="consent" type="checkbox" required />
      <span>Согласен(на) на обработку персональных данных для связи по заявке — <a href="/politika-konfidencialnosti" target="_blank">политика конфиденциальности</a></span>
    </label>
  </Field>

  <div class="notice notice--error" role="alert" tabindex="-1" data-form-error hidden>
    <strong>Заявка не отправлена</strong>
    <p></p>
  </div>

  <div class="booking-form__submit">
    <button class="btn btn--block" type="submit">
      <span class="spinner" aria-hidden="true"></span>
      <span data-label="Отправить заявку">Отправить заявку</span>
    </button>
    <p class="field__hint">Это заявка, а не подтверждённая бронь: администратор перезвонит и подтвердит стол.</p>
  </div>
</form>

<section class="success" tabindex="-1" data-booking-success hidden aria-labelledby="b-success-title">
  <svg class="success__mark" width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M12 20.5l5.5 5.5L29 14.5" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg>
  <h2 id="b-success-title" class="h3">Заявка получена</h2>
  <p class="success__id">№ <span data-success-id></span></p>
  <p data-success-summary></p>
  <p><strong>Бронь ещё не подтверждена.</strong> Администратор свяжется с вами по номеру <span data-success-phone></span>, чтобы подтвердить стол. Если планы изменятся — позвоните: <a href={`tel:${site.phone.tel}`}>{site.phone.local}</a>.</p>
  <button class="btn btn--ghost" type="button" data-booking-again>Оставить ещё одну заявку</button>
</section>

<style>
  /* Поле согласия без видимой подписи-заголовка */
  .field--consent :global(.field__label) {
    display: none;
  }
  .date-chips .chip span {
    min-width: 4.75rem;
  }
  .date-input {
    max-width: 16rem;
  }
  .js-enhanced .date-input {
    margin-top: 0.25rem;
  }
  .time-groups {
    display: grid;
    gap: 1rem;
  }
  .time-groups > div {
    display: grid;
    gap: 0.5rem;
  }
  .time-groups .label {
    color: var(--ink-3);
  }
  .banquet-hint {
    justify-self: start;
    font-size: var(--fs-small);
    color: var(--tomato);
  }
  .booking-form__submit {
    display: grid;
    gap: 0.75rem;
  }
</style>

<script>
  import { setupRequestForm, humanDate } from '../scripts/request-form';
  import { validateBooking, formatPhone, normalizePhone } from '../lib/validation';
  import { addDays, bookingSlots, weekdayOf, zonedNow, WEEKDAY_SHORT } from '../lib/hours';
  import { site } from '../config/site';

  const form = document.querySelector<HTMLFormElement>('[data-booking-form]');
  const success = document.querySelector<HTMLElement>('[data-booking-success]');

  if (form && success) {
    const dateInput = form.querySelector<HTMLInputElement>('input[name="date"]')!;
    const dateChips = form.querySelector<HTMLElement>('[data-date-chips]')!;
    const timeWrap = form.querySelector<HTMLElement>('[data-time-chips]')!;
    const timeSelect = form.querySelector<HTMLSelectElement>('[data-time-select]')!;
    const noSlots = form.querySelector<HTMLElement>('[data-no-slots]')!;
    const guests = form.querySelector<HTMLInputElement>('input[name="guests"]')!;
    const banquetHint = form.querySelector<HTMLElement>('[data-banquet-hint]')!;
    const monthFmt = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'short', timeZone: 'UTC' });

    // Со скриптом время выбирается кнопками, выпадающий список не нужен
    timeSelect.remove();
    timeWrap.hidden = false;
    form.classList.add('js-enhanced');

    let selectedTime = '';
    const now = () => zonedNow();

    // --- Дата: быстрые кнопки на неделю вперёд + календарь ---
    const today = now().date;
    dateInput.min = today;
    dateInput.max = addDays(today, site.booking.horizonDays);

    const dayLabel = (iso: string, i: number) => {
      const [y, m, d] = iso.split('-').map(Number);
      const short = monthFmt.format(new Date(Date.UTC(y, m - 1, d))).replace('.', '');
      const name = i === 0 ? 'Сегодня' : i === 1 ? 'Завтра' : WEEKDAY_SHORT[weekdayOf(iso)];
      return { name, short };
    };

    for (let i = 0; i < 7; i++) {
      const iso = addDays(today, i);
      const { name, short } = dayLabel(iso, i);
      const label = document.createElement('label');
      label.className = 'chip';
      label.innerHTML = `<input type="radio" name="date-quick" value="${iso}"><span>${name}<small>${short}</small></span>`;
      dateChips.append(label);
    }
    dateChips.hidden = false;
    dateChips.setAttribute('role', 'radiogroup');
    dateChips.setAttribute('aria-label', 'Ближайшие даты');

    dateChips.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      dateInput.value = input.value;
      renderTimes();
    });
    dateInput.addEventListener('change', () => {
      dateChips.querySelectorAll<HTMLInputElement>('input').forEach((r) => (r.checked = r.value === dateInput.value));
      renderTimes();
    });

    // --- Время: доступные слоты на выбранную дату, разбитые на «день» и «вечер» ---
    function renderTimes() {
      const slots = dateInput.value ? bookingSlots(dateInput.value, now()) : [];
      if (!slots.includes(selectedTime)) selectedTime = '';
      timeWrap.innerHTML = '';
      noSlots.hidden = !dateInput.value || slots.length > 0;
      if (!dateInput.value) {
        timeWrap.innerHTML = '<p class="field__hint">Сначала выберите дату.</p>';
        return;
      }
      const groups = [
        { title: 'День', items: slots.filter((s) => s < '17:00') },
        { title: 'Вечер', items: slots.filter((s) => s >= '17:00') },
      ].filter((g) => g.items.length);
      for (const g of groups) {
        const block = document.createElement('div');
        block.innerHTML = `<p class="label">${g.title}</p>`;
        const chips = document.createElement('div');
        chips.className = 'chips';
        chips.setAttribute('role', 'radiogroup');
        chips.setAttribute('aria-label', `${g.title}: время`);
        for (const t of g.items) {
          const label = document.createElement('label');
          label.className = 'chip';
          label.innerHTML = `<input type="radio" name="time" value="${t}" ${t === selectedTime ? 'checked' : ''}><span>${t}</span>`;
          chips.append(label);
        }
        block.append(chips);
        timeWrap.append(block);
      }
    }
    timeWrap.addEventListener('change', (e) => (selectedTime = (e.target as HTMLInputElement).value));

    // По умолчанию — сегодня, а если на сегодня поздно — завтра
    const initial = bookingSlots(today, now()).length ? today : addDays(today, 1);
    dateInput.value = initial;
    dateInput.dispatchEvent(new Event('change'));

    // --- Гости: кнопки − / + ---
    const stepButtons = form.querySelectorAll<HTMLButtonElement>('[data-step]');
    const syncGuests = () => {
      const n = Number(guests.value) || 0;
      stepButtons[0].disabled = n <= 1;
      stepButtons[1].disabled = n >= site.booking.maxGuests;
      banquetHint.hidden = n < site.booking.maxGuests;
    };
    stepButtons.forEach((b) => {
      b.hidden = false;
      b.addEventListener('click', () => {
        const n = Math.min(site.booking.maxGuests, Math.max(1, (Number(guests.value) || 0) + Number(b.dataset.step)));
        guests.value = String(n);
        guests.dispatchEvent(new Event('input', { bubbles: true }));
        syncGuests();
      });
    });
    guests.addEventListener('input', syncGuests);
    syncGuests();

    // Номер телефона приводим к единому виду при уходе из поля
    const phone = form.querySelector<HTMLInputElement>('input[name="phone"]')!;
    phone.addEventListener('blur', () => {
      const n = normalizePhone(phone.value);
      if (n) phone.value = formatPhone(n);
    });

    setupRequestForm(form, {
      validate: validateBooking,
      collect: (f) => ({
        date: dateInput.value,
        time: selectedTime,
        guests: guests.value,
        name: (f.elements.namedItem('name') as HTMLInputElement).value,
        phone: phone.value,
        comment: (f.elements.namedItem('comment') as HTMLTextAreaElement).value,
        consent: (f.elements.namedItem('consent') as HTMLInputElement).checked,
        website: (f.elements.namedItem('website') as HTMLInputElement).value,
      }),
      onSuccess(id, data) {
        success.querySelector('[data-success-id]')!.textContent = id;
        success.querySelector('[data-success-summary]')!.textContent =
          `${humanDate(String(data.date))}, ${data.time} · гостей: ${data.guests}`;
        const n = normalizePhone(String(data.phone));
        success.querySelector('[data-success-phone]')!.textContent = n ? formatPhone(n) : String(data.phone);
        form.hidden = true;
        success.hidden = false;
        success.focus();
        success.scrollIntoView({ block: 'start' });
      },
    });

    success.querySelector('[data-booking-again]')?.addEventListener('click', () => {
      form.reset();
      selectedTime = '';
      dateInput.value = initial;
      dateInput.dispatchEvent(new Event('change'));
      syncGuests();
      success.hidden = true;
      form.hidden = false;
      dateInput.focus();
    });
  }
</script>
