---
/** Нижняя панель действий на телефоне: главное — под большим пальцем. */
import { site } from '../config/site';

interface Props {
  /** На странице бронирования кнопка «Стол» не нужна */
  hideBooking?: boolean;
}
const { hideBooking = false } = Astro.props;
---

<nav class="mbar" aria-label="Быстрые действия">
  <a class="mbar__item" href={`tel:${site.phone.tel}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
    Позвонить
  </a>
  <a class="mbar__item" href="/menu">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14M5 9h14M5 14h9M5 19h6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
    Меню
  </a>
  {!hideBooking && (
    <a class="mbar__item mbar__item--primary" href="/bron">Забронировать стол</a>
  )}
</nav>

<style>
  .mbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    gap: 0.5rem;
    padding: 0.5rem var(--gutter) calc(0.5rem + env(safe-area-inset-bottom));
    background: rgb(243 237 226 / 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid var(--line);
  }
  .mbar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    min-width: min(4.25rem, 18vw);
    min-height: 3.25rem;
    font-size: 0.75rem;
    text-align: center;
    text-decoration: none;
  }
  .mbar__item svg {
    width: 1.35rem;
    height: 1.35rem;
  }
  .mbar__item--primary {
    flex: 1;
    min-width: 0;
    padding-inline: 0.5rem;
    flex-direction: row;
    border-radius: var(--radius);
    background: var(--tomato);
    color: var(--on-tomato);
    font-size: 1rem;
    font-weight: 500;
  }
  .mbar__item--primary:active {
    background: var(--tomato-press);
  }
  @media (min-width: 45em) {
    .mbar {
      display: none;
    }
  }
</style>
