---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import MenuStrip from '../components/MenuStrip.astro';
import MenuList from '../components/MenuList.astro';
import { allergyNote, menu, menuGroups } from '../data/menu';

// Сквозная нумерация разделов по всей странице
const num = (id: string) => String(menu.findIndex((c) => c.id === id) + 1).padStart(2, '0');
const groups = menuGroups
  .map((g) => ({ ...g, categories: menu.filter((c) => c.group === g.id) }))
  .filter((g) => g.categories.length > 0);
---

<Base
  title="Меню"
  description="Меню ресторана «Базилик» в Тамбове с ценами: стартеры, салаты, паста, супы, блюда из рыбы и мяса, гриль, десерты, напитки, бар и винная карта."
>
  <PageIntro label="Меню">
    <Fragment slot="title">Меню <span class="accent">ресторана</span></Fragment>
    <p>Разделы с фотографиями листаются вправо — пальцем, кнопками или стрелками на клавиатуре.</p>
    <p class="menu-allergy">{allergyNote}</p>
  </PageIntro>

  <nav class="catnav" aria-label="Разделы меню" data-catnav>
    <div class="wrap">
      <ul class="catnav__list">
        {
          groups.map((g) => (
            <li class="catnav__group">
              <span class="catnav__glabel">{g.title}</span>
              <ul aria-label={g.title}>
                {g.categories.map((c) => (
                  <li>
                    <a href={`#${c.id}`} data-cat-link={c.id}>
                      <span class="catnav__num" aria-hidden="true">{num(c.id)}</span>
                      {c.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  {
    groups.map((g) => (
      <section class="mgroup" id={`razdel-${g.id}`} aria-labelledby={`razdel-${g.id}-title`}>
        <div class="wrap mgroup__head">
          <h2 id={`razdel-${g.id}-title`} class="h-display">{g.title}</h2>
          {g.note && <p class="mgroup__note muted">{g.note}</p>}
        </div>
        {g.categories.map((c) => (
          <section class:list={['cat', `cat--${c.layout}`]} id={c.id} aria-labelledby={`${c.id}-title`} data-cat>
            <div class="wrap cat__head">
              <p class="cat__num" aria-hidden="true">{num(c.id)}</p>
              <h3 id={`${c.id}-title`} class="h2 cat__title">{c.title}</h3>
              {c.note && <p class="cat__note">{c.note}</p>}
            </div>
            {c.layout === 'gallery' ? (
              <MenuStrip id={c.id} label={c.title} items={c.items} itemHeading="h4" />
            ) : (
              <div class="wrap">
                <MenuList items={c.items} />
              </div>
            )}
            {c.footnotes && (
              <div class="wrap cat__foot">
                {c.footnotes.map((f) => <p>{f}</p>)}
              </div>
            )}
          </section>
        ))}
      </section>
    ))
  }

  <section class="wrap menu-end">
    <p class="h2">Выбрали? <span class="accent">Забронируйте стол</span></p>
    <a class="btn" href="/bron">Оставить заявку</a>
  </section>
</Base>

<style>
  .menu-allergy {
    font-size: var(--fs-body);
    color: var(--ink-2);
  }

  /* Липкая навигация по разделам: на телефоне листается по горизонтали */
  .catnav {
    position: sticky;
    top: var(--header-h);
    z-index: 30;
    background-color: var(--paper);
    border-block: 1px solid var(--line);
  }
  .catnav .wrap {
    padding-inline: 0;
  }
  .catnav__list {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .catnav__list::-webkit-scrollbar {
    display: none;
  }
  /* Группа: подпись «Кухня», «Бар»… и её разделы */
  .catnav__group {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: none;
  }
  .catnav__group + .catnav__group {
    margin-left: 0.75rem;
    padding-left: 1rem;
    border-left: 1px solid var(--line-strong);
  }
  .catnav__glabel {
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
    padding-right: 0.25rem;
    white-space: nowrap;
  }
  .catnav__group ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }
  .catnav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius);
    white-space: nowrap;
    text-decoration: none;
    font-size: 0.95rem;
    transition:
      background-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease);
  }
  .catnav a:hover {
    background: var(--paper-2);
  }
  .catnav a[aria-current='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .catnav__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.85rem;
    opacity: 0.7;
  }

  /* Группа меню: «Кухня», «Напитки», «Бар», «Вина» */
  .mgroup {
    padding-top: var(--space-5);
  }
  .mgroup + .mgroup {
    margin-top: var(--space-5);
  }
  .mgroup__head {
    display: grid;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
    scroll-margin-top: calc(var(--header-h) + 3.75rem);
  }
  .mgroup__note {
    font-size: var(--fs-small);
  }

  .cat {
    padding-top: var(--space-5);
    scroll-margin-top: calc(var(--header-h) + 3.75rem);
  }
  .cat__head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: 1.25rem;
    margin-bottom: var(--space-4);
  }
  .cat__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.2rem, 1rem + 1vw, 2rem);
    color: var(--tomato);
  }
  .cat__note {
    grid-column: 2;
    margin-top: 0.4rem;
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .cat__foot {
    display: grid;
    gap: 0.35rem;
    margin-top: 1rem;
    font-size: var(--fs-small);
    font-style: italic;
    color: var(--ink-2);
  }
  .cat--gallery .cat__head {
    margin-bottom: 1rem;
  }
  .menu-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: var(--space-6);
    margin-bottom: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-strong);
  }
</style>

<script>
  // Подсветка текущего раздела в навигации и прокрутка самой навигации к нему
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-cat-link]').forEach((a) => links.set(a.dataset.catLink!, a));
  const list = document.querySelector<HTMLElement>('.catnav__list');
  let current = '';

  const setCurrent = (id: string) => {
    if (id === current) return;
    current = id;
    links.forEach((a, key) => {
      if (key === id) {
        a.setAttribute('aria-current', 'true');
        if (list) {
          const left = a.getBoundingClientRect().left - list.getBoundingClientRect().left + list.scrollLeft - 16;
          list.scrollTo({ left, behavior: 'smooth' });
        }
      } else a.removeAttribute('aria-current');
    });
  };

  const sections = [...document.querySelectorAll<HTMLElement>('[data-cat]')];
  const onScroll = () => {
    const line = window.innerHeight * 0.3;
    let active = sections[0]?.id ?? '';
    for (const s of sections) if (s.getBoundingClientRect().top <= line) active = s.id;
    setCurrent(active);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
