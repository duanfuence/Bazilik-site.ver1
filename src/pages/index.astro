---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import OpenStatus from '../components/OpenStatus.astro';
import MenuStrip from '../components/MenuStrip.astro';
import HoursTable from '../components/HoursTable.astro';
import { routeLinks, site } from '../config/site';
import { homePreviewIds, menu } from '../data/menu';
import { chef } from '../data/chef';
import { occasions } from '../data/events';
import { restaurantSchema } from '../lib/schema';

// Превью меню: по две позиции из избранных разделов
const preview = menu
  .filter((c) => homePreviewIds.includes(c.id))
  .flatMap((c) => c.items.slice(0, 2).map((item) => ({ ...item, kicker: c.title })));

const origin = Astro.site ?? new URL(Astro.url.origin);
---

<Base
  title="Главная"
  fullTitle="Базилик — ресторан в Тамбове на Селезнёвской"
  description="Ресторан «Базилик» в Тамбове, улица Селезнёвская, 2А. Кухня шефа Александра Боярского, меню, бронирование столов и банкеты. Телефон 55-82-53."
  jsonLd={restaurantSchema(origin)}
>
  <!-- Обложка -->
  <section class="cover scene" aria-labelledby="cover-title">
    <div class="wrap">
      <div class="cover__meta label">
        <span>Ресторан · {site.city}</span>
        <OpenStatus />
      </div>

      <div class="cover__grid">
        <h1 id="cover-title" class="cover__title">
          <span class="h-mega cover__word">Базилик</span>
        </h1>

        <Photo name="heroHall" class="cover__hall" priority sizes="(min-width: 1024px) 38vw, 88vw" caption="Зал вечером" />
        <Photo name="heroDish" class="cover__dish" sizes="(min-width: 1024px) 18vw, 40vw" />

        <div class="cover__intro">
          <p class="lead">
            Ресторан в Тамбове с кухней шефа Александра Боярского — победителя номинации «Лучший кондитер России».
            Обеды, ужины, праздники и банкеты.
          </p>
          <div class="cover__actions">
            <a class="btn" href="/bron">Забронировать стол</a>
            <a class="arrow-link" href="/menu">Смотреть меню</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Сегодня: часы, адрес, телефон — то, что ищут первым -->
  <section class="today on-paper-2" aria-label="Часы работы и контакты">
    <div class="wrap today__grid">
      <div>
        <p class="label muted">Часы работы</p>
        <HoursTable />
      </div>
      <div>
        <p class="label muted">Адрес</p>
        <p class="today__big">{site.address.short}</p>
        <a class="arrow-link today__link" href={routeLinks[0].href} target="_blank" rel="noopener">
          Построить маршрут<span class="visually-hidden"> в Яндекс Картах (откроется в новой вкладке)</span>
        </a>
      </div>
      <div>
        <p class="label muted">Телефон</p>
        <a class="today__big today__phone" href={`tel:${site.phone.tel}`}>{site.phone.local}</a>
        <p class="muted today__note">Бронь, банкеты и любые вопросы</p>
      </div>
    </div>
  </section>

  <!-- 01 Меню -->
  <section class="section menu-teaser scene" aria-labelledby="menu-title">
    <div class="wrap grid">
      <p class="index label teaser-index"><span class="index__num">01</span> Меню</p>
      <h2 id="menu-title" class="h-display teaser-title" data-reveal>
        Кухня <span class="accent">в деталях</span>
      </h2>
      <div class="teaser-text" data-reveal>
        <p>Закуски, горячее и десерты от шефа-кондитера. Листайте ленту — или откройте полное меню с ценами и выходом блюд.</p>
        <a class="arrow-link" href="/menu">Открыть меню</a>
      </div>
      <div class="teaser-strip">
        <MenuStrip id="home" label="Избранное из меню" items={preview} fit />
      </div>
    </div>
  </section>

  <!-- 02 Шеф -->
  <section class="section on-dark chef scene scene--stage" aria-labelledby="chef-title">
    <div class="wrap grid">
      <div class="chef__photo" data-reveal>
        <Photo name="chefPortrait" sizes="(min-width: 1024px) 40vw, 100vw" />
      </div>
      <div class="chef__body">
        <p class="index label"><span class="index__num">02</span> Шеф</p>
        <h2 id="chef-title" class="h-display chef__name" data-reveal>
          Александр <span class="accent">Боярский</span>
        </h2>
        <p class="lead muted">{chef.role}. Кондитер и повар, судья кулинарных чемпионатов.</p>

        <ol class="ledger">
          {
            chef.achievements.map((a, i) => (
              <li class="ledger__row" data-reveal style={`--reveal-delay:${i * 90}ms`}>
                <span class="ledger__mark">{a.mark}</span>
                <span class="ledger__text">{a.title}</span>
              </li>
            ))
          }
        </ol>
        <p class="chef__exp muted">{chef.experience.join(' · ')}</p>
        <a class="arrow-link" href="/shef">О шефе</a>
      </div>
    </div>
  </section>

  <!-- 03 Пространство -->
  <section class="section space scene" aria-labelledby="space-title">
    <div class="wrap grid space__grid">
      <p class="index label space__index"><span class="index__num">03</span> Пространство</p>
      <Photo name="interiorWide" class="space__wide" sizes="(min-width: 1024px) 62vw, 100vw" caption="Общий план зала" />
      <Photo name="interiorTable" class="space__table" sizes="(min-width: 1024px) 28vw, 60vw" />
      <div class="space__text" data-reveal>
        <h2 id="space-title" class="h2">Свет, стол <span class="accent">и&nbsp;разговор</span></h2>
        <p>
          Приходите на обед, ужин с близкими или встречу с друзьями. Если нужен стол на определённое время — оставьте заявку
          заранее, администратор перезвонит и подтвердит.
        </p>
        <a class="arrow-link" href="/o-restorane">О ресторане</a>
      </div>
      <Photo name="interiorDetail" class="space__detail" sizes="(min-width: 1024px) 20vw, 40vw" />
    </div>
  </section>

  <!-- 04 Банкеты -->
  <section class="section on-tomato banquet scene scene--stage" aria-labelledby="banquet-title">
    <div class="wrap grid">
      <p class="index label banquet__index"><span class="index__num">04</span> Банкеты и события</p>
      <h2 id="banquet-title" class="h-display banquet__title" data-reveal>
        Праздник <span class="accent">за большим столом</span>
      </h2>
      <ul class="banquet__list" aria-label="Поводы">
        {occasions.map((o) => <li>{o.title}</li>)}
      </ul>
      <div class="banquet__cta" data-reveal>
        <p>Расскажите о поводе, дате и числе гостей — администратор перезвонит и предложит формат и меню.</p>
        <div class="banquet__actions">
          <a class="btn btn--paper" href="/bankety#zayavka">Оставить заявку</a>
          <a class="btn btn--ghost" href="/bankety">Подробнее</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Как нас найти -->
  <section class="section find" aria-labelledby="find-title">
    <div class="wrap grid">
      <p class="index label find__index"><span class="index__num">05</span> Как нас найти</p>
      <h2 id="find-title" class="find__address h-display" data-reveal>
        Селезнёвская, <span class="accent">2А</span>
      </h2>
      <div class="find__col find__col--a">
        <p class="label muted">Телефон</p>
        <a class="find__phone" href={`tel:${site.phone.tel}`}>{site.phone.local}</a>
        <p class="muted">{site.phone.international}</p>
      </div>
      <div class="find__col find__col--b">
        <p class="label muted">Часы</p>
        <HoursTable />
      </div>
      <div class="find__col find__col--c">
        <p class="label muted">Маршрут</p>
        <ul class="find__routes">
          {
            routeLinks.map((l) => (
              <li>
                <a class="arrow-link" href={l.href} target="_blank" rel="noopener">
                  {l.label}
                  <span class="visually-hidden"> (откроется в новой вкладке)</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="btn btn--ink find__book" href="/bron">Забронировать стол</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Сцены главной ----------
   * Первые блоки главной — «сцены»: на компьютере каждая занимает экран под шапкой,
   * а размеры фото и заголовков считаются от доступной высоты (--fold), а не только от ширины.
   * min-height, а не height: при крупном шрифте или узком окне сцена просто становится выше.
   * Прокрутка остаётся обычной — никакого примагничивания и перехвата колёсика.
   */
  .scene {
    --fold: calc(100vh - var(--header-h));
    --scene-pad: clamp(1.5rem, 5vh, 4rem);
  }
  @supports (height: 100svh) {
    .scene {
      --fold: calc(100svh - var(--header-h));
      --scene-pad: clamp(1.5rem, 5svh, 4rem);
    }
  }
  @media (min-width: 900px) and (min-height: 560px) {
    .scene {
      min-height: var(--fold);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-block: var(--scene-pad);
    }
  }

  /* ---------- Обложка ---------- */
  .cover {
    padding-block: 1.25rem var(--space-5);
  }
  @media (min-width: 900px) and (min-height: 560px) {
    .cover {
      justify-content: flex-start;
      padding-block: 1.25rem clamp(1rem, 3svh, 2rem);
    }
  }
  .cover__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .cover__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 1.5rem;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .cover__title {
    grid-column: 1 / -1;
    position: relative;
    z-index: 2;
    display: grid;
    line-height: 1;
    /* размер названия ограничен шириной своей колонки — оно не заходит на фото */
    container-type: inline-size;
  }
  .cover__word {
    display: block;
    margin-left: -0.04em;
    /* «Базилик» в Bona Nova ≈ 3,45 em шириной: 28cqi держит слово в колонке;
       26svh — на невысоких экранах название не съедает место у фотографий */
    font-size: min(var(--fs-mega), 26vh, 28cqi);
  }
  @supports (height: 100svh) {
    .cover__word {
      font-size: min(var(--fs-mega), 26svh, 28cqi);
    }
  }
  .cover__hall {
    grid-column: 3 / -1;
    justify-self: end;
    /* над фото — мета-строка и название, под ним — подпись и нижняя панель телефона */
    width: clamp(12rem, calc((var(--fold) - 18rem) * 0.8), 100%);
  }
  .cover__dish {
    display: none;
  }
  .cover__intro {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.5rem;
  }
  .cover__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  @media (min-width: 600px) and (max-width: 899px) {
    .cover__hall {
      grid-column: 7 / -1;
      grid-row: 2;
    }
    .cover__intro {
      grid-column: 1 / 7;
      grid-row: 2;
      align-self: end;
    }
  }
  @media (min-width: 900px) {
    .cover__grid {
      --hall-offset: clamp(1rem, 5svh, 4rem);
      grid-template-rows: auto auto 1fr;
    }
    .cover__title {
      grid-column: 1 / 8;
      grid-row: 1;
      align-self: start;
    }
    .cover__hall {
      grid-column: 8 / -1;
      grid-row: 1 / 4;
      margin-top: var(--hall-offset);
      /* 10rem — мета-строка, отступы и подпись к кадру */
      width: clamp(14rem, calc((var(--fold) - 10rem - var(--hall-offset)) * 0.8), 100%);
    }
    .cover__dish {
      display: block;
      grid-column: 1 / 4;
      grid-row: 2 / 4;
      align-self: start;
      margin-top: clamp(1rem, 4svh, 2.5rem);
    }
    .cover__intro {
      grid-column: 4 / 8;
      grid-row: 2 / 4;
      align-self: start;
      margin-top: clamp(1rem, 4svh, 2.5rem);
    }
  }

  /* ---------- Сегодня ---------- */
  .today {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  .today__grid {
    display: grid;
    gap: 2rem var(--col-gap);
  }
  @media (min-width: 768px) {
    .today__grid {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
  }
  .today__grid > div {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }
  .today__big {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.6rem);
    line-height: 1.05;
  }
  .today__phone {
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .today__phone:hover {
    color: var(--tomato);
  }
  .today__link {
    justify-self: start;
  }
  .today__note {
    font-size: var(--fs-small);
  }

  /* ---------- Меню ---------- */
  .menu-teaser {
    padding-bottom: var(--space-5);
    /* высота самого высокого кадра ленты: экран минус отступы сцены, кнопки ленты и подписи к блюдам */
    --strip-h: clamp(12rem, calc(var(--fold) - 2 * var(--scene-pad) - 24.5rem), 30rem);
    /* насколько ленте выйти за поля, чтобы дойти до края окна */
    --bleed: calc(var(--gutter) + max(0px, (100vw - var(--max)) / 2));
  }
  .teaser-index {
    grid-column: 1 / -1;
  }
  .teaser-title {
    grid-column: 1 / -1;
    margin-top: 1.5rem;
  }
  .teaser-text {
    grid-column: 1 / -1;
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: 1.5rem;
    max-width: 30rem;
  }
  @media (min-width: 900px) {
    .teaser-title {
      grid-column: 1 / 8;
    }
    .teaser-text {
      grid-column: 9 / -1;
      align-self: end;
    }
  }
  .teaser-strip {
    grid-column: 1 / -1;
    margin-top: var(--space-4);
    margin-inline: calc(-1 * var(--bleed));
    min-width: 0;
  }
  /*
   * Сцена «разворот»: заголовок и текст слева, лента справа уходит за край окна.
   * Так карточки получают ширину для подписей, а кадры — высоту экрана.
   */
  @media (min-width: 900px) and (min-height: 560px) {
    .menu-teaser {
      padding-bottom: var(--scene-pad);
    }
    .menu-teaser .grid {
      align-items: center;
    }
    .teaser-title {
      grid-column: 1 / 5;
      grid-row: 2;
      align-self: end;
      margin-top: clamp(1rem, 4svh, 3rem);
      font-size: min(var(--fs-display), 11svh, 6.4vw);
    }
    .teaser-text {
      grid-column: 1 / 5;
      grid-row: 3;
      align-self: start;
      margin-top: clamp(0.75rem, 2.5svh, 1.5rem);
    }
    .teaser-strip {
      grid-column: 5 / -1;
      grid-row: 2 / 4;
      margin-top: clamp(1rem, 4svh, 3rem);
      margin-inline: 0 calc(-1 * var(--bleed));
      /* лента начинается от колонки, справа оставляем поле до края окна */
      --strip-inset-start: 0px;
      --strip-inset-end: var(--gutter);
    }
    .teaser-strip :global(.strip__bar) {
      max-width: none;
      margin: 0;
      padding-inline: 0 var(--gutter);
    }
  }
  /* На невысоких экранах лента компактнее: состав блюд скрывает сама лента (см. MenuStrip, режим fit) */
  @media (min-width: 900px) and (min-height: 560px) and (max-height: 820px) {
    .menu-teaser {
      --strip-h: clamp(11rem, calc(var(--fold) - 2 * var(--scene-pad) - 22rem), 30rem);
    }
  }

  /* ---------- Шеф ---------- */
  .chef .grid {
    row-gap: 2.5rem;
  }
  .chef__photo {
    grid-column: 1 / -1;
  }
  .chef__body {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.5rem;
    align-content: start;
    justify-items: start;
  }
  @media (min-width: 900px) {
    .chef__photo {
      grid-column: 1 / 6;
    }
    .chef__body {
      grid-column: 7 / -1;
    }
  }
  .chef__name {
    margin-top: 0.5rem;
  }
  .ledger {
    list-style: none;
    padding: 0;
    width: 100%;
    margin-top: 1rem;
  }
  .ledger__row {
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: baseline;
    padding-block: 1rem;
    border-top: 1px solid rgb(239 232 218 / 0.2);
  }
  .ledger__row:last-child {
    border-bottom: 1px solid rgb(239 232 218 / 0.2);
  }
  .ledger__mark {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.8rem + 2.4vw, 4rem);
    line-height: 0.9;
    color: var(--sage);
    white-space: nowrap;
  }
  .ledger__text {
    font-size: var(--fs-lead);
    line-height: 1.35;
  }
  .chef__exp {
    font-size: var(--fs-small);
  }
  @media (min-width: 900px) and (min-height: 560px) {
    .chef .grid {
      align-items: center;
    }
    /* портрет 4:5 по высоте экрана */
    .chef__photo {
      width: min(100%, calc((var(--fold) - 2 * var(--scene-pad)) * 0.8));
    }
    .chef__body {
      gap: clamp(0.5rem, 1.8svh, 1.5rem);
    }
    .chef__name {
      margin-top: 0;
      font-size: min(var(--fs-display), 9svh);
    }
    .chef__body .lead {
      font-size: min(var(--fs-lead), max(1rem, 2.6svh));
    }
    .ledger {
      margin-top: 0;
    }
    .ledger__row {
      padding-block: clamp(0.4rem, 1.4svh, 1rem);
    }
    .ledger__mark {
      font-size: min(clamp(2.4rem, 1.8rem + 2.4vw, 4rem), 6svh);
    }
    .ledger__text {
      font-size: min(var(--fs-lead), max(1rem, 2.4svh));
    }
  }
  /* Узкое окно компьютера: тексту шефа — на колонку больше, чтобы строки не дробились */
  @media (min-width: 900px) and (max-width: 1199px) and (min-height: 560px) {
    .chef__photo {
      grid-column: 1 / 6;
    }
    .chef__body {
      grid-column: 6 / -1;
    }
    .chef__exp {
      display: none;
    }
  }

  /* ---------- Пространство ---------- */
  .space {
    /* высота общего плана зала: экран минус подпись, текст и отступы */
    --space-h: clamp(12rem, calc(var(--fold) - 31rem), 34rem);
  }
  .space__grid {
    row-gap: 2rem;
  }
  .space__index {
    grid-column: 1 / -1;
  }
  .space__wide {
    grid-column: 1 / -1;
  }
  .space__table {
    grid-column: 4 / -1;
  }
  .space__text {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 34rem;
  }
  .space__detail {
    display: none;
  }
  @media (min-width: 900px) {
    .space__grid {
      row-gap: clamp(1rem, 2.5svh, 2rem);
    }
    .space__wide {
      grid-column: 1 / 9;
      grid-row: 2;
      width: min(100%, calc(var(--space-h) * 16 / 9));
    }
    .space__table {
      grid-column: 10 / -1;
      grid-row: 2 / 4;
      justify-self: end;
      width: min(100%, calc(var(--space-h) * 0.8));
      margin-top: calc(var(--space-h) * 0.3);
    }
    .space__text {
      grid-column: 1 / 6;
      grid-row: 3;
    }
    .space__detail {
      display: block;
      grid-column: 6 / 9;
      grid-row: 3;
      justify-self: end;
      align-self: start;
      width: min(100%, 11rem);
    }
  }
  @media (min-width: 900px) and (min-height: 560px) {
    .space__text .h2 {
      font-size: min(var(--fs-h2), 7svh);
    }
    /* Общий план — во всю ширину колонок, высота от экрана: кадр становится панорамным, а не мельчает */
    .space__wide {
      width: 100%;
      container-type: inline-size;
    }
    .space__wide :global(.photo__ph),
    .space__wide :global(img) {
      aspect-ratio: auto;
