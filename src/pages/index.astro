  /* ---------- Переходы между сценами ----------
   * Анимации привязаны к положению прокрутки (scroll-driven animations): браузер считает их сам,
   * без обработчиков прокрутки, и они не могут «держать» страницу — прокрутка всегда обычная.
   * Свойства анимации заданы по отдельности: минификатор склеивает сокращённое «animation»
   * с animation-timeline в запись, которую браузеры не принимают.
   * Только transform, opacity и clip-path. Где технология не поддерживается или включено
   * «уменьшение движения», всё просто стоит на местах; текст появляется через data-reveal.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Вступление мягко отдаляется, когда его прокручивают */
      .cover__grid {
        animation-name: cover-out;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 90%;
      }

      /* Тёмная и томатная сцены «раздвигаются»: фон вырастает до полной ширины при входе */
      .scene--stage {
        position: relative;
        isolation: isolate;
        background-color: transparent;
      }
      .scene--stage::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background: var(--stage-bg);
        transform-origin: 50% 100%;
        animation-name: stage-open;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }
      .chef {
        --stage-bg: var(--olive);
      }
      .banquet {
        --stage-bg: var(--tomato);
      }

      /* Фотографии сцен открываются из-под маски, кадр внутри слегка «оседает» */
      .chef__photo :global(.photo),
      .space__grid > :global(.photo) {
        view-timeline: --shot block;
        /* увеличенный в начале кадр не должен расширять страницу */
        overflow: clip;
        animation-name: shot-mask;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --shot;
        animation-range: entry 5% cover 45%;
      }
      .chef__photo :global(.photo__ph),
      .space__grid > :global(.photo) :global(.photo__ph),
      .chef__photo :global(img),
      .space__grid > :global(.photo) :global(img) {
        animation-name: shot-settle;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --shot;
        animation-range: entry 5% cover 50%;
      }

      /* Лента «Кухня в деталях» раскрывается веером: дальние кадры приходят издалека */
      .menu-teaser {
        view-timeline: --teaser block;
      }
      .teaser-strip :global(.strip__item) {
        animation-name: strip-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --teaser;
        animation-range: entry 15% cover 45%;
      }
      .teaser-strip :global(.strip__item:nth-child(2)) {
        --from: 10vw;
      }
      .teaser-strip :global(.strip__item:nth-child(3)) {
        --from: 16vw;
      }
      .teaser-strip :global(.strip__item:nth-child(n + 4)) {
        --from: 22vw;
      }
    }
  }
  @keyframes cover-out {
    to {
      opacity: 0.35;
      transform: scale(0.97);
    }
  }
  @keyframes stage-open {
