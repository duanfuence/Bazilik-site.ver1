# Публичный адрес сайта (canonical, Open Graph, sitemap). Обязателен для продакшена.
SITE_URL=https://bazilik.example

# Куда доставлять заявки на бронирование и банкеты.
# Можно включить один или несколько каналов. Если не настроен ни один,
# сервер честно отвечает «приём заявок временно недоступен» (HTTP 503),
# а сайт предлагает позвонить.

# 1) Telegram-бот: токен от @BotFather и id чата администраторов.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2) Вебхук (CRM, Make, n8n, собственный сервис): заявка уходит POST-запросом в JSON.
REQUESTS_WEBHOOK_URL=
# Необязательный секрет, передаётся в заголовке X-Webhook-Secret.
REQUESTS_WEBHOOK_SECRET=

# 3) Журнал в файле JSON Lines (для локальной разработки или как резервная копия).
REQUESTS_LOG_FILE=

# Порт и хост Node-сервера (npm run preview / продакшен).
HOST=0.0.0.0
PORT=4321
